@{
    ViewData["Title"] = "Авторизация";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #0e1621;
            color: white;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .auth-box {
            background-color: #17212b;
            border: 1px solid #2b5278;
            border-radius: 12px;
            padding: 40px;
            width: 420px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        }

        h2 {
            color: #fff;
            text-align: center;
            margin-bottom: 20px;
        }

        label {
            color: #b0c4de;
        }

        input, select {
            width: 100%;
            margin-bottom: 12px;
            background-color: #0e1621;
            border: 1px solid #2b5278;
            color: white;
            border-radius: 6px;
            padding: 8px 10px;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #58a6ff;
            background-color: #101a26;
        }

        button {
            background-color: #2b5278;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 10px 16px;
            width: 100%;
            transition: background 0.3s;
        }

        button:hover {
            background-color: #3c6995;
        }

        .switch-link {
            margin-top: 10px;
            text-align: center;
            cursor: pointer;
            color: #58a6ff;
            text-decoration: underline;
        }

        .switch-link:hover {
            color: #7cc3ff;
        }

        .hidden {
            display: none;
        }

        .message {
            margin-top: 10px;
            text-align: center;
        }

        .error { color: #ff5555; }
        .success { color: #4cd964; }
    </style>
</head>
<body>
    <div class="auth-box">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <h2>🔐 Авторизация успешна</h2>
            <p class="text-center">Привет, <b>@User.Identity.Name</b>!</p>
            <form method="post" asp-action="Logout">
                <button type="submit" style="background-color:#6b2737;">🚪 Выйти</button>
            </form>
            <div class="switch-link" onclick="location.href='/Home/Index'">Перейти в Messenger</div>
        }
        else
        {
            <!-- Вход -->
            <div id="login-form">
                <h2>Вход</h2>
                <form method="post" asp-action="Login">
                    <label>Логин:</label>
                    <input type="text" name="username" required />

                    <label>Пароль:</label>
                    <input type="password" name="password" required />

                    <button type="submit">Войти</button>
                </form>
                <div class="switch-link" onclick="showRegister()">Создать аккаунт</div>
            </div>

            <!-- Регистрация -->
            <div id="register-form" class="hidden">
                <h2>Регистрация</h2>
                <form method="post" asp-action="Register">
                    <label>Логин:</label>
                    <input type="text" name="username" required />

                    <label>Пароль:</label>
                    <input type="password" name="password" required />

                    <label>Подтверждение пароля:</label>
                    <input type="password" name="confirmPassword" required />

                    <label>Имя отображения:</label>
                    <input type="text" name="displayName" required />

                    <label>Отдел:</label>
                    <select name="departmentId">
                        @foreach (var dep in ViewBag.Departments)
                        {
                            <option value="@dep.Id">@dep.Name</option>
                        }
                    </select>

                    <button type="submit">Зарегистрироваться</button>
                </form>
                <div class="switch-link" onclick="showLogin()">Уже есть аккаунт</div>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <p class="message error">@ViewBag.Error</p>
        }
        @if (ViewBag.Message != null)
        {
            <p class="message success">@ViewBag.Message</p>
        }
    </div>

    <script>
        function showRegister() {
            document.getElementById("login-form").classList.add("hidden");
            document.getElementById("register-form").classList.remove("hidden");
        }

        function showLogin() {
            document.getElementById("register-form").classList.add("hidden");
            document.getElementById("login-form").classList.remove("hidden");
        }
    </script>
</body>
</html>
