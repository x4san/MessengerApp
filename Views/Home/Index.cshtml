@{
    ViewData["Title"] = "Messenger";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <style>
        body {
            margin: 0;
            height: 100vh;
            background: #0e1621;
            color: white;
            display: flex;
            flex-direction: column;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Верхняя панель */
        .top-bar {
            height: 55px;
            background-color: #17212b;
            border-bottom: 1px solid #2b5278;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            background-color: #2b5278;
            color: white;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 16px;
            font-weight: bold;
        }

        .username {
            font-weight: 500;
            color: white;
        }

        .logout-btn {
            background-color: #2b5278;
            border: none;
            color: white;
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 14px;
            cursor: pointer;
        }

        .logout-btn:hover {
            background-color: #3c6fa5;
        }

        .chat-title {
            color: #ffffff;
            font-size: 18px;
            font-weight: bold;
        }

        /* Основное тело */
        .main-container {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        .sidebar {
            width: 30%;
            background: #17212b;
            border-right: 1px solid #2b5278;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .chat-item {
            padding: 10px;
            border-bottom: 1px solid #2b5278;
            cursor: pointer;
        }

        .chat-item:hover {
            background: #2b5278;
        }

        .chat-window {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            background-color: #0e1621;
        }

        #messages {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #c0c0c0;
            text-align: center;
        }

        .message-input {
            display: flex;
            border-top: 1px solid #2b5278;
        }

        .message-input input {
            flex: 1;
            background: #17212b;
            border: none;
            color: white;
            padding: 10px;
        }

        .message-input button {
            background: #2b5278;
            border: none;
            color: white;
            padding: 10px 20px;
        }

        /* Плавающая кнопка */
        .floating-btn {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background-color: #2b5278;
            color: white;
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: 0.3s;
        }

        .floating-btn:hover {
            background-color: #3c6fa5;
            transform: scale(1.1);
        }

        /* Модалка */
        .modal-content {
            background: #17212b;
            color: white;
        }
        .user-item {
            padding: 10px;
            border-bottom: 1px solid #2b5278;
            cursor: pointer;
        }
        .user-item:hover {
            background: #2b5278;
        }
    </style>
</head>
<body>
    <!-- Верхняя панель -->
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">
                @if (!string.IsNullOrEmpty(ViewBag.DisplayName))
                {
                    @ViewBag.DisplayName.Substring(0, 1).ToUpper()
                }
                else
                {
                    <text>?</text>
                }
            </div>
            <span class="username">@ViewBag.DisplayName</span>
            <form method="post" asp-controller="Account" asp-action="Logout" style="margin:0;">
                <button class="logout-btn">Выйти</button>
            </form>
        </div>
        <div class="chat-title" id="chatTitle">Messenger</div>
    </div>

    <!-- Основная область -->
    <div class="main-container">
        <div class="sidebar">
            <h4 class="p-3">Чаты</h4>
            <div id="chatList"></div>

            <!-- ✏️ Плавающая кнопка -->
            <button class="floating-btn" data-bs-toggle="modal" data-bs-target="#usersModal">✏️</button>
        </div>

        <div class="chat-window">
            <div id="messages">Выберите чат</div>
            <div class="message-input">
                <input type="text" id="messageInput" placeholder="Введите сообщение..." />
                <button id="sendButton">Отправить</button>
            </div>
        </div>
    </div>

    <!-- Модалка для списка пользователей -->
    <div class="modal fade" id="usersModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Новый диалог</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="usersList">Загрузка...</div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const username = "@User.Identity?.Name";
        const displayName = "@ViewBag.DisplayName";
        let currentChatId = null;

        const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

        connection.on("ReceiveMessage", (sender, message, time) => {
            const msgDiv = document.createElement("div");
            msgDiv.style.textAlign = "left";
            msgDiv.innerHTML = `<b>${sender}</b> [${time}]: ${message}`;
            const messagesContainer = document.getElementById("messages");
            messagesContainer.appendChild(msgDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        });

        connection.start().then(loadChats);

        async function loadChats() {
            const res = await fetch(`/Chat/List?username=${username}`);
            const chats = await res.json();
            const list = document.getElementById("chatList");
            list.innerHTML = "";
            chats.forEach(c => {
                const div = document.createElement("div");
                div.className = "chat-item";
                div.innerText = c.name;
                div.onclick = () => openChat(c.id, c.name);
                list.appendChild(div);
            });
        }

        async function openChat(chatId, chatName) {
            currentChatId = chatId;
            document.getElementById("chatTitle").textContent = chatName;
            const messagesContainer = document.getElementById("messages");
            messagesContainer.innerHTML = "";
            messagesContainer.style.alignItems = "flex-start";
            messagesContainer.style.justifyContent = "flex-start";
            await connection.invoke("JoinChat", chatId);

            const res = await fetch(`/Chat/Messages?chatId=${chatId}`);
            const msgs = await res.json();
            msgs.forEach(m => {
                const div = document.createElement("div");
                div.style.textAlign = "left";
                div.innerHTML = `<b>${m.sender}</b> [${m.time}]: ${m.content}`;
                messagesContainer.appendChild(div);
            });
        }

        async function sendMessage() {
            const text = document.getElementById("messageInput").value.trim();
            if (!text || !currentChatId) return;
            await connection.invoke("SendMessage", currentChatId, username, text);
            document.getElementById("messageInput").value = "";
        }

        document.getElementById("sendButton").onclick = sendMessage;
        document.getElementById("messageInput").addEventListener("keydown", function (e) {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // ===== Загрузка списка пользователей =====
        const usersModal = document.getElementById("usersModal");
        usersModal.addEventListener("show.bs.modal", async () => {
            const res = await fetch(`/Chat/Users?currentUsername=${username}`);
            const users = await res.json();
            const list = document.getElementById("usersList");
            list.innerHTML = "";
            users.forEach(u => {
                const div = document.createElement("div");
                div.className = "user-item";
                div.innerText = u.displayName;
                div.onclick = async () => {
                    const resp = await fetch(`/Chat/CreatePrivateChat`, {
                        method: "POST",
                        headers: { "Content-Type": "application/x-www-form-urlencoded" },
                        body: `username1=${username}&username2=${u.username}`
                    });
                    if (resp.ok) {
                        const chat = await resp.json();
                        bootstrap.Modal.getInstance(usersModal).hide();
                        await loadChats();
                        openChat(chat.id, chat.name);
                    } else {
                        alert("Не удалось создать чат");
                    }
                };
                list.appendChild(div);
            });
        });
    </script>
</body>
</html>
