@model IEnumerable<MessengerApp.Models.Chat>

@{
    ViewData["Title"] = "Messenger";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            margin: 0;
            height: 100vh;
            background-color: #0e1621;
            color: white;
            display: flex;
            font-family: 'Segoe UI', sans-serif;
        }
        .sidebar {
            width: 30%;
            background-color: #17212b;
            border-right: 1px solid #2b5278;
            display: flex;
            flex-direction: column;
            position: relative;
        }
        .search {
            padding: 10px;
            border-bottom: 1px solid #2b5278;
        }
        .search input {
            width: 100%;
            border: none;
            padding: 8px;
            border-radius: 5px;
            background-color: #0e1621;
            color: white;
        }
        .chat-list {
            flex: 1;
            overflow-y: auto;
        }
        .chat-item {
            padding: 10px;
            border-bottom: 1px solid #2b5278;
            cursor: pointer;
        }
        .chat-item:hover {
            background-color: #2b5278;
        }
        .new-chat {
            position: absolute;
            bottom: 20px;
            left: 20px;
            width: 50px;
            height: 50px;
            background-color: #2b5278;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: pointer;
        }
        .chat-window {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: #0e1621;
            position: relative;
        }
        #messages {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
        }
        .message-input {
            display: flex;
            border-top: 1px solid #2b5278;
        }
        .message-input input {
            flex: 1;
            background-color: #17212b;
            border: none;
            color: white;
            padding: 10px;
        }
        .message-input button {
            background-color: #2b5278;
            color: white;
            border: none;
            padding: 10px 20px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="search">
            <input id="searchBox" type="text" placeholder="Поиск пользователей..." />
        </div>

        <!-- 📜 Список чатов из базы -->
        <div id="chatList" class="chat-list">
            @if (!Model.Any())
            {
                <div class="p-3 text-secondary">Нет активных чатов</div>
            }
            else
            {
                @foreach (var chat in Model)
                {
                    <div class="chat-item" onclick="openChat(@chat.Id)">
                        <b>@chat.Name</b><br />
                        <small>Чат ID: @chat.Id</small>
                    </div>
                }
            }
        </div>

        <div class="new-chat" title="Создать чат" onclick="openNewChat()">✏️</div>
    </div>

    <!-- 🪟 Окно чата -->
    <div class="chat-window" id="chatWindow">
        <div id="messages" class="p-3 text-secondary">Выберите чат для общения</div>

        <div class="message-input">
            <input type="text" id="messageInput" placeholder="Введите сообщение..." />
            <button id="sendButton">Отправить</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const currentUser = "@ViewBag.DisplayName";
        if (!currentUser || currentUser.trim() === "") {
            window.location.href = "/Account/TestAuth";
        }

        const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

        connection.on("ReceiveMessage", (user, message, time) => {
            const msgDiv = document.createElement("div");
            msgDiv.innerHTML = `<b>${user}</b>: ${message}`;
            document.getElementById("messages").appendChild(msgDiv);
        });

        connection.start().catch(err => console.error(err.toString()));

        document.getElementById("sendButton").addEventListener("click", function () {
            const msg = document.getElementById("messageInput").value;
            if (msg.trim() === "") return;
            connection.invoke("SendMessage", 1, currentUser, msg); // chatId пока тестовый
            document.getElementById("messageInput").value = "";
        });

        async function openChat(chatId) {
            const res = await fetch(`/Chat/Room?id=${chatId}`);
            const html = await res.text();
            document.getElementById("chatWindow").innerHTML = html;
        }

        function openNewChat() {
            alert("Создание нового чата (в разработке)");
        }
    </script>
</body>
</html>
